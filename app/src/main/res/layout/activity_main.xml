<?xml version="1.0" encoding="utf-8"?>


<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >


    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:id="@+id/toolbar"
        app:titleTextAppearance="@style/Toolbar.TitleText" />


    <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/re
s-auto"                                                                                          android:id="@+id/cardEq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        android:layout_below="@id/toolbar">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <Switch
                android:id="@+id/switchEnable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/enable_equalizer" />


            <LinearLayout
                android:id="@+id/linearLayoutEqual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="32dp"
                android:paddingRight="32dp"
                android:paddingBottom="16dp"
                android:layout_below="@id/switchEnable">

                <!-- band 0 -->
                <TextView
                    android:id="@+id/centerFreq0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/mySeekBar0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="1"/>

                <!-- band 1 -->
                <TextView
                    android:id="@+id/centerFreq1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/mySeekBar1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="1"/>

                <!-- band 2 -->
                <TextView
                    android:id="@+id/centerFreq2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/mySeekBar2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="1"/>

                <!-- band 3 -->
                <TextView
                    android:id="@+id/centerFreq3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/mySeekBar3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="1"/>

                <!-- band 4 -->
                <TextView
                    android:id="@+id/centerFreq4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp" />
                <SeekBar
                    android:id="@+id/mySeekBar4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:progress="1"/>

            </LinearLayout>



                <TextView
                    android:id="@+id/presetTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="48dp"
                    android:text="@string/presets"
                    android:layout_below="@id/linearLayoutEqual"
                    android:paddingBottom="16dp"
                    android:textAlignment="center"
                    android:layout_marginStart="48dp" />

                <Spinner
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/linearLayoutEqual"
                    android:layout_alignParentRight="true"
                    android:layout_marginRight="48dp"
                    android:paddingBottom="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="48dp" />


        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cardEq"
        android:layout_gravity="center"
        android:layout_marginHorizontal="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- System volume control on the left (vertical) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">
                
                <TextView
                    android:id="@+id/systemVolTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/system_volume"
                    android:layout_marginBottom="8dp" />
                    
                <Button
                    android:id="@+id/systemVolUp"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🔊" />
                
                <!-- Vertical SeekBar using rotation -->
                <!-- We place it inside a FrameLayout to help with bounding box -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp">
                    
                    <SeekBar
                        android:id="@+id/systemVolSeekBar"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:rotation="270"
                        android:transformPivotX="100dp"
                        android:transformPivotY="20dp" />
                </FrameLayout>
                    
                <Button
                    android:id="@+id/systemVolDown"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="🔉" />
                    
            </LinearLayout>

            <!-- Vertical stack for horizontal effect sliders on the right -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="16dp">

                <!-- bass control with buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <Button
                            android:id="@+id/volUpBass"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▲" />
                        <Button
                            android:id="@+id/volDownBass"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▼" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bass_boost" />
                        <SeekBar
                            android:id="@+id/bassSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <Switch
                            android:id="@+id/bassSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- loudness control with buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <Button
                            android:id="@+id/volUpLoud"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▲" />
                        <Button
                            android:id="@+id/volDownLoud"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▼" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/volTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/loudness" />
                        <SeekBar
                            android:id="@+id/volSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <Switch
                            android:id="@+id/volSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- virtualizer control with buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">
                        <Button
                            android:id="@+id/volUpVirtual"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▲" />
                        <Button
                            android:id="@+id/volDownVirtual"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:text="▼" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/virtualizer" />
                        <SeekBar
                            android:id="@+id/virtualSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                        <Switch
                            android:id="@+id/virtualSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</RelativeLayout>



