# Git ignore for Android/Gradle project

# IDE files
*.iml
/.idea
/.vscode
.DS_Store

# Android build artifacts
/captures
.externalNativeBuild
.cxx
# Build klasörlerini yoksay
build/
bin/
gen/
*.aar

# APK and other outputs
*.apk
*.ap_
*.apks

# but keep APKs we intentionally commit for releases
!src/tag/v1.2/*.apk

# local configuration
/local.properties
local.properties
/release.properties
release.properties
debug.keystore
debug.keystore.*
debugkey.properties
/debugkey.properties
debug-keystore.jks
/debug-keystore.jks
releasekey.properties
/releasekey.properties
release-keystore.jks
/release-keystore.jks

# ignore only wrapper JAR, not other gradle files
gradle-wrapper.jar

# key stores and sensitive files
/release-keystore.jks
*debug.keystore
*.keystore
*.jks
release-keystore.jks
/app/app/release-keystore.jks
/app/release-keystore.jks
*.key
*.pem
*keystore*
*key*

# caches
/.gradle/

# logs and temporary
*.log
*.txt
*.backup
*.py
*.sh
*.bat
*.cmd
*.ps1
*hata*
*error*
*HATA*
*ERROR*
*.tmp
*.swp
*.swo
*.log.*
*.log-*
*.m4a
*.py

# compressed archives/backups
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.zip
*.gz
*.7z
*.rar
*.xz
*.bz2
*.backup.tar.gz
*.backup.tar
*.bak
*.mp4
*.mkv
*.avi
*.mov
*.mp3
*.wav
*.flac
*.ogg
*.iso
*.img
*.flv

# Android-specific
google-services.json
*.hprof

# Java/Kotlin artifacts
*.class
*.jar
*.war
*.nar
*.ear

# IntelliJ additional
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# JVM crash logs
hs_err_pid*
replay_pid*

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

